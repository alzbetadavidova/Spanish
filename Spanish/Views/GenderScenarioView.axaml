<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spanish.ViewModels"
             xmlns:core="using:Spanish.Core"
             xmlns:views="using:Spanish.Views"
             x:Class="Spanish.Views.GenderScenarioView"
             x:DataType="vm:GenderScenarioViewModel"
             Focusable="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="D1" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.El}" />
        <KeyBinding Gesture="NumPad1" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.El}" />
        <KeyBinding Gesture="D2" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.La}" />
        <KeyBinding Gesture="NumPad2" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.La}" />
        <KeyBinding Gesture="D3" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.Los}" />
        <KeyBinding Gesture="NumPad3" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.Los}" />
        <KeyBinding Gesture="D4" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.Las}" />
        <KeyBinding Gesture="NumPad4" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.Las}" />
        <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
    </UserControl.KeyBindings>

    <StackPanel Spacing="14" Width="460">
        <TextBlock Text="{Binding Heading}" Classes="muted" HorizontalAlignment="Center" />
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Word}" Classes="prompt" />
            <TextBlock Text="{Binding Translation}" Classes="translation" />
        </StackPanel>

        <UniformGrid Columns="4" IsEnabled="{Binding !IsChecked}">
            <!-- Tints are decorative only; el/la/los/las are not colour-coded by gender or number. -->
            <Button Content="el · 1" Classes="pastel5" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.El}"
                    FontSize="16" Padding="8,10"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0" />
            <Button Content="la · 2" Classes="pastel1" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.La}"
                    FontSize="16" Padding="8,10"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0" />
            <Button Content="los · 3" Classes="pastel4" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.Los}"
                    FontSize="16" Padding="8,10"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0" />
            <Button Content="las · 4" Classes="pastel2" Command="{Binding ChooseCommand}" CommandParameter="{x:Static core:Article.Las}"
                    FontSize="16" Padding="8,10"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" />
        </UniformGrid>

        <Border Classes="feedback" Classes.success="{Binding IsCorrect}" Classes.danger="{Binding IsIncorrect}"
                IsVisible="{Binding IsChecked}">
            <TextBlock Text="{Binding Feedback}" HorizontalAlignment="Center" />
        </Border>
        <views:ExceptionNotes Notes="{Binding Notes}" IsVisible="{Binding ShowNotes}" />

        <Button Content="Next · Enter" Command="{Binding SubmitCommand}" Classes="accent"
                HorizontalAlignment="Center" IsVisible="{Binding IsChecked}" />
    </StackPanel>
</UserControl>
