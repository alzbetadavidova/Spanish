<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spanish.ViewModels"
             xmlns:views="using:Spanish.Views"
             x:Class="Spanish.Views.PrepositionEditorView"
             x:DataType="vm:PrepositionEditorViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="heading" Margin="0,0,0,16" />
        <views:ExceptionNotes DockPanel.Dock="Top" Notes="{Binding ExceptionNotes}"
                              IsVisible="{Binding HasExceptionNotes}" Margin="0,0,0,16" />
        <views:EditorFooter DockPanel.Dock="Bottom" />

        <ScrollViewer>
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                <TextBlock Grid.Row="0" Text="Spanish" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding Spanish}" PlaceholderText="cerca de" />
                    <TextBlock Text="One word (de) or several (al lado de)." Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SpanishError}" Classes="error"
                               IsVisible="{Binding SpanishError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="English" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding English}" PlaceholderText="near; close to" />
                    <TextBlock Text="Separate alternatives with a semicolon. Each one is used in phrases like &quot;near the park&quot;."
                               Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EnglishError}" Classes="error"
                               IsVisible="{Binding EnglishError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Nouns" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <views:NounChips Grid.Row="2" Grid.Column="1"
                                 Hint="Pick nouns that read naturally after it with &quot;the&quot;: near the park." />

                <TextBlock Grid.Row="3" Text="Topics" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <views:TopicChips Grid.Row="3" Grid.Column="1" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
