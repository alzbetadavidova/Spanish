<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spanish.ViewModels"
             xmlns:views="using:Spanish.Views"
             x:Class="Spanish.Views.CardScenarioView"
             x:DataType="vm:CardScenarioViewModel"
             Focusable="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Space" Command="{Binding FlipCommand}" />
        <KeyBinding Gesture="D1" Command="{Binding DidNotKnowCommand}" />
        <KeyBinding Gesture="NumPad1" Command="{Binding DidNotKnowCommand}" />
        <KeyBinding Gesture="D2" Command="{Binding KnewItCommand}" />
        <KeyBinding Gesture="NumPad2" Command="{Binding KnewItCommand}" />
    </UserControl.KeyBindings>

    <StackPanel Spacing="16" Width="460">
        <TextBlock Text="{Binding Heading}" Classes="muted" HorizontalAlignment="Center" />

        <Button Classes="card" Command="{Binding FlipCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" Focusable="False">
            <Grid RowDefinitions="4,*">
                <!-- A pastel rule along the card's top edge; the corners match the card's radius. -->
                <Border Background="{StaticResource PastelRainbow}" CornerRadius="12,12,0,0" />
                <Border Grid.Row="1" MinHeight="216" Padding="24">
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="{Binding Front}" Classes="prompt" IsVisible="{Binding !IsFlipped}" />
                        <TextBlock Text="Click or press Space to flip" Classes="muted" HorizontalAlignment="Center"
                                   Margin="0,8,0,0" IsVisible="{Binding !IsFlipped}" />

                        <!-- Once flipped the question becomes the context line and the answer takes the focus. -->
                        <TextBlock Text="{Binding Front}" Classes="translation" IsVisible="{Binding IsFlipped}" />
                        <TextBlock Text="{Binding Back}" Classes="prompt" IsVisible="{Binding IsFlipped}" />
                        <TextBlock Text="{Binding BackDetail}" Classes="translation" IsVisible="{Binding IsFlipped}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Button>

        <views:ExceptionNotes Notes="{Binding Notes}" IsVisible="{Binding ShowNotes}" />

        <UniformGrid Columns="2" IsVisible="{Binding IsFlipped}">
            <Button Classes="danger" Command="{Binding DidNotKnowCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Margin="0,0,6,0">
                <TextBlock Text="Didn't know · 1" />
            </Button>
            <Button Classes="success" Command="{Binding KnewItCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="Knew it · 2" />
            </Button>
        </UniformGrid>
    </StackPanel>
</UserControl>
