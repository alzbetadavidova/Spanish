<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spanish.ViewModels"
             x:Class="Spanish.Views.NounChips"
             x:DataType="vm:NounLinkedEditorViewModel"
             x:Name="Root">

    <StackPanel Spacing="4">
        <ItemsControl ItemsSource="{Binding Nouns}" IsVisible="{Binding HasNouns}" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToggleOption">
                    <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,8,8" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding #Root.Hint}" Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding HasNouns}" />
        <TextBlock Text="No nouns yet. Add them on the Nouns tab." Classes="muted" TextWrapping="Wrap" Margin="0,7,0,0"
                   IsVisible="{Binding !HasNouns}" />
        <TextBlock Text="{Binding NounsError}" Classes="error"
                   IsVisible="{Binding NounsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
</UserControl>
