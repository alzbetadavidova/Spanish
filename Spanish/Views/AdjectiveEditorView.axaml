<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spanish.ViewModels"
             xmlns:views="using:Spanish.Views"
             x:Class="Spanish.Views.AdjectiveEditorView"
             x:DataType="vm:AdjectiveEditorViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="heading" Margin="0,0,0,16" />
        <views:EditorFooter DockPanel.Dock="Bottom" />

        <ScrollViewer>
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                <TextBlock Grid.Row="0" Text="Spanish" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding Spanish}" PlaceholderText="bajo" />
                    <TextBlock Text="The masculine singular form." Classes="muted" />
                    <TextBlock Text="{Binding SpanishError}" Classes="error"
                               IsVisible="{Binding SpanishError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="English" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding English}" PlaceholderText="short; low" />
                    <TextBlock Text="Separate alternatives with a semicolon." Classes="muted" />
                    <TextBlock Text="{Binding EnglishError}" Classes="error"
                               IsVisible="{Binding EnglishError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Forms" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <UniformGrid Columns="3">
                        <TextBox Text="{Binding Feminine}" PlaceholderText="baja" Margin="0,0,4,0"
                                 ToolTip.Tip="Feminine singular" />
                        <TextBox Text="{Binding MasculinePlural}" PlaceholderText="bajos" Margin="4,0"
                                 ToolTip.Tip="Masculine plural" />
                        <TextBox Text="{Binding FemininePlural}" PlaceholderText="bajas" Margin="4,0,0,0"
                                 ToolTip.Tip="Feminine plural" />
                    </UniformGrid>
                    <UniformGrid Columns="3">
                        <TextBlock Text="feminine" Classes="muted" />
                        <TextBlock Text="masculine plural" Classes="muted" Margin="4,0,0,0" />
                        <TextBlock Text="feminine plural" Classes="muted" Margin="4,0,0,0" />
                    </UniformGrid>
                    <TextBlock Text="Suggested from the Spanish word; fix them for irregular adjectives." Classes="muted" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Nouns" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                    <ItemsControl ItemsSource="{Binding Nouns}" IsVisible="{Binding HasNouns}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToggleOption">
                                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,8,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Pick the nouns to practice this adjective with." Classes="muted"
                               IsVisible="{Binding HasNouns}" />
                    <TextBlock Text="No nouns yet. Add them on the Nouns tab." Classes="muted" Margin="0,7,0,0"
                               IsVisible="{Binding !HasNouns}" />
                    <TextBlock Text="{Binding NounsError}" Classes="error"
                               IsVisible="{Binding NounsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Topics" Classes="label" VerticalAlignment="Top" Margin="0,7,0,0" />
                <views:TopicChips Grid.Row="4" Grid.Column="1" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
