<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spanish.ViewModels"
             xmlns:views="using:Spanish.Views"
             x:Class="Spanish.Views.TypedScenarioView"
             x:DataType="vm:TypedScenarioViewModel">

    <StackPanel Spacing="14" Width="460">
        <TextBlock Text="{Binding Heading}" Classes="muted" HorizontalAlignment="Center" />
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Prompt}" Classes="prompt" />
            <TextBlock Text="{Binding PromptDetail}" Classes="translation"
                       IsVisible="{Binding PromptDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Wraps long answers (dates with times); Enter still submits because AcceptsReturn stays off. -->
        <TextBox x:Name="AnswerBox" Text="{Binding Answer}" PlaceholderText="Type your answer"
                 FontSize="20" Padding="12,10"
                 HorizontalContentAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 IsReadOnly="{Binding IsChecked}">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
            </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Text="{Binding ValidationMessage}" Classes="error" HorizontalAlignment="Center"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Border Classes="feedback" Classes.success="{Binding IsCorrect}" Classes.danger="{Binding IsIncorrect}"
                IsVisible="{Binding IsChecked}">
            <TextBlock Text="{Binding Feedback}" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </Border>
        <views:ExceptionNotes Notes="{Binding Notes}" IsVisible="{Binding ShowNotes}" />
        <ContentControl Content="{Binding VerbForms}" IsVisible="{Binding ShowVerbForms}" />

        <Button Command="{Binding SubmitCommand}" HorizontalAlignment="Center" Classes="accent">
            <Panel>
                <TextBlock Text="Check · Enter" IsVisible="{Binding !IsChecked}" />
                <TextBlock Text="Next · Enter" IsVisible="{Binding IsChecked}" />
            </Panel>
        </Button>
    </StackPanel>
</UserControl>
